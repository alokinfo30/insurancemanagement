rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // -------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------
    function isValidUser(data) {
      return data.uid is string &&
        data.email is string &&
        data.role in ['ADMIN', 'CUSTOMER'];
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if true;
    }

    // -------------------------------------------------------------
    // Admins Collection
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // Categories Collection
    // -------------------------------------------------------------
    function isValidCategory(data) {
      return data.category_name is string && data.category_name.size() > 0;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    // -------------------------------------------------------------
    // Policies Collection
    // -------------------------------------------------------------
    function isValidPolicy(data) {
      return data.policy_name is string && data.policy_name.size() > 0;
    }

    match /policies/{policyId} {
      allow read: if true;
      allow create, update: if isValidId(policyId) && isValidPolicy(incoming());
      allow delete: if isValidId(policyId);
    }

    // -------------------------------------------------------------
    // Policy Records Collection
    // -------------------------------------------------------------
    function isValidPolicyRecord(data) {
      return data.customer_id is string && data.policy_id is string;
    }

    match /policy_records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidPolicyRecord(incoming());
      allow delete: if isValidId(recordId);
    }

    // -------------------------------------------------------------
    // Claims Collection (Submit and Track Insurance Claims)
    // -------------------------------------------------------------
    function isValidClaim(data) {
      return data.customer_id is string &&
        data.policy_id is string &&
        data.claim_amount is number &&
        data.status in ['Pending', 'Under Review', 'Approved', 'Rejected'];
    }

    match /claims/{claimId} {
      allow read: if true;
      allow create, update: if isValidId(claimId) && isValidClaim(incoming());
      allow delete: if isValidId(claimId);
    }

    // -------------------------------------------------------------
    // Questions Collection
    // -------------------------------------------------------------
    function isValidQuestion(data) {
      return data.customer_id is string && data.description is string;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create, update: if isValidId(questionId) && isValidQuestion(incoming());
      allow delete: if isValidId(questionId);
    }
  }
}
