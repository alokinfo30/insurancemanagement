<%- include('../partials/admin_header') %>

<head>
  <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <style media="screen">
    a:link {
      text-decoration: none;
    }
    .view-toggle-btn {
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      border: 1px solid #cbd5e1;
      background: #f1f5f9;
      color: #334155;
    }
    .view-toggle-btn.active {
      background: #1e3a8a;
      color: white;
      border-color: #1e3a8a;
    }
    .page-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 2px solid #e2e8f0;
    }
  </style>
</head>

<div class="container" style="max-width: 1200px;">
  <div class="page-header-bar">
    <div>
      <h3 style="margin: 0; font-weight: 700; color: #1e293b;">
        <i class="fa fa-shield" style="color: #2563eb;"></i> Policy Management Dashboard
      </h3>
      <p style="margin: 4px 0 0 0; color: #64748b; font-size: 14px;">
        Browse, manage, and configure active insurance plans stored persistently in Firestore Cloud.
      </p>
    </div>

    <div style="display: flex; gap: 8px; align-items: center;">
      <button type="button" class="view-toggle-btn active" id="btnShowCards">
        <i class="fa fa-th-large"></i> Card View
      </button>
      <button type="button" class="view-toggle-btn" id="btnShowTable">
        <i class="fa fa-list"></i> Table View
      </button>
      <a href="/admin-add-policy" class="btn btn-primary" style="margin-left: 8px; font-weight: 600;">
        <i class="fa fa-plus"></i> Add Policy
      </a>
    </div>
  </div>

  <!-- Section 1: Card-Based Policy Management Dashboard Component -->
  <div id="cardViewSection">
    <%- include('../components/policy_cards_dashboard', { policies: policies, isAdmin: true, isCustomer: false }) %>
  </div>

  <!-- Section 2: Traditional Table View (Toggleable) -->
  <div id="tableViewSection" style="display: none; margin-top: 20px;">
    <div class="panel panel-primary">
      <div class="panel-heading">
        <h6 class="panel-title" style="text-align: center; font-size: 16px; font-weight: 700;">All Policy Specifications</h6>
      </div>
      <table class="table table-hover" id="dev-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Policy Name</th>
            <th>Category</th>
            <th>Sum Assurance</th>
            <th>Premium</th>
            <th>Tenure</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (policies && policies.length > 0) { %>
            <% policies.forEach(function(t, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><strong><%= t.policy_name %></strong></td>
                <td><span class="label label-info"><%= t.category_name %></span></td>
                <td>$<%= Number(t.sum_assurance).toLocaleString() %></td>
                <td>$<%= Number(t.premium).toLocaleString() %>/yr</td>
                <td><%= t.tenure %> yrs</td>
                <td>
                  <a class="btn btn-primary btn-xs" href="/update-policy/<%= t.id %>">
                    <span class="glyphicon glyphicon-edit"></span> Edit
                  </a>
                  <a class="btn btn-danger btn-xs" href="/delete-policy/<%= t.id %>" onclick="return confirm('Are you sure you want to delete this policy?');">
                    <span class="glyphicon glyphicon-trash"></span> Delete
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center">No policies found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.getElementById('btnShowCards').addEventListener('click', function() {
    this.classList.add('active');
    document.getElementById('btnShowTable').classList.remove('active');
    document.getElementById('cardViewSection').style.display = 'block';
    document.getElementById('tableViewSection').style.display = 'none';
  });

  document.getElementById('btnShowTable').addEventListener('click', function() {
    this.classList.add('active');
    document.getElementById('btnShowCards').classList.remove('active');
    document.getElementById('cardViewSection').style.display = 'none';
    document.getElementById('tableViewSection').style.display = 'block';
  });
</script>

<%- include('../partials/admin_footer') %>
