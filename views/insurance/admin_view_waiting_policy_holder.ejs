<%- include('../partials/admin_header') %>

<head>
  <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
  <style media="screen">
    a:link {
      text-decoration: none;
    }
    h6 {
      text-align: center;
    }
  </style>
</head>

<div class="container">
  <div class="panel panel-primary">
    <div class="panel-heading">
      <h6 class="panel-title">Policy Holders Waiting for Approval</h6>
    </div>
    <table class="table table-hover" id="dev-table">
      <thead>
        <tr>
          <th>Serial No.</th>
          <th>Policy Name</th>
          <th>Customer Name</th>
          <th>Applied Date</th>
          <th>Status</th>
          <th class="text-right">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (policyrecords && policyrecords.length > 0) { %>
          <% policyrecords.forEach(function(t, index) { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= t.Policy %></td>
              <td><%= t.customer %></td>
              <td><%= t.creation_date %></td>
              <td><span class="label label-warning" style="font-size: 14px;"><%= t.status %></span></td>
              <td class="text-right">
                <a class="btn btn-primary btn-sm" href="/approve-request/<%= t.id %>">Approve</a>
                <a class="btn btn-danger btn-sm" href="/reject-request/<%= t.id %>">Reject</a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center">No waiting policy holder records found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/admin_footer') %>
