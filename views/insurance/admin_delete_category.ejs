<%- include('../partials/admin_header') %>

<head>
  <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
  <style media="screen">
    a:link {
      text-decoration: none;
    }
    h6 {
      text-align: center;
    }
  </style>
</head>

<div class="container">
  <div class="panel panel-primary">
    <div class="panel-heading">
      <h6 class="panel-title">Delete Category</h6>
    </div>
    <table class="table table-hover" id="dev-table">
      <thead>
        <tr>
          <th>Serial No.</th>
          <th>Category Name</th>
          <th>Creation Date</th>
          <th>Delete Category</th>
        </tr>
      </thead>
      <tbody>
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(function(t, index) { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= t.category_name %></td>
              <td><%= t.creation_date %></td>
              <td><a class="btn btn-danger btn-xs" href="/delete-category/<%= t.id %>" onclick="return confirm('Are you sure you want to delete this category?');"><span class="glyphicon glyphicon-trash"></span> Delete</a></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="4" class="text-center">No categories found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/admin_footer') %>
