<%- include('../partials/admin_header') %>

<head>
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
</head>

<h2 style="text-align:center; color:blue;">ADD POLICY</h2>
<form method="POST" action="/admin-add-policy" autocomplete="off" style="max-width: 600px; margin: 20px auto;">
  <div class="form-group">
    <label for="category_id">Category</label>
    <select name="category_id" class="form-control" required>
      <option value="">Select Category</option>
      <% categories.forEach(function(c) { %>
        <option value="<%= c.id %>"><%= c.category_name %></option>
      <% }); %>
    </select>
  </div>

  <div class="form-group">
    <label for="policy_name">Policy Name</label>
    <input type="text" name="policy_name" class="form-control" placeholder="Jeevan Surbhi" required>
  </div>

  <div class="form-group">
    <label for="sum_assurance">Sum Assurance</label>
    <input type="number" name="sum_assurance" class="form-control" placeholder="100000" required>
  </div>

  <div class="form-group">
    <label for="premium">Premium</label>
    <input type="number" name="premium" class="form-control" placeholder="5000" required>
  </div>

  <div class="form-group">
    <label for="tenure">Tenure (Years)</label>
    <input type="number" name="tenure" class="form-control" placeholder="12" required>
  </div>

  <br>
  <button type="submit" class="btn btn-primary">ADD</button>
  <a href="/admin-policy" class="btn btn-default">Back</a>
</form>

<%- include('../partials/admin_footer') %>
