<%- include('../partials/customer_header') %>

<head>
  <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <style>
    .profile-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 30px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
      margin-bottom: 30px;
    }
    .camera-container {
      background: #0f172a;
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      width: 100%;
      max-width: 440px;
      min-height: 280px;
      margin: 0 auto 16px auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    #cameraStream {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }
    #photoPreview {
      max-width: 100%;
      max-height: 280px;
      display: none;
      border-radius: 8px;
    }
    .profile-avatar-large {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid #04868f;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }
  </style>
</head>

<div class="container" style="max-width: 950px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 2px solid #e2e8f0;">
    <div>
      <h3 style="margin: 0; font-weight: 700; color: #1e293b;">
        <i class="fa fa-user-circle" style="color: #04868f;"></i> Customer Profile & Camera
      </h3>
      <p style="margin: 4px 0 0 0; color: #64748b; font-size: 14px;">
        Capture a live photo using your device camera or upload an image to update your profile picture.
      </p>
    </div>
    <a href="/customer/customer-dashboard" class="btn btn-default" style="border-radius: 20px;">
      <i class="fa fa-arrow-left"></i> Back to Dashboard
    </a>
  </div>

  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="alert alert-success alert-dismissible" role="alert">
      <i class="fa fa-check-circle"></i> <%= successMessage %>
    </div>
  <% } %>

  <div class="row">
    <!-- Left Column: Camera Capture -->
    <div class="col-md-6">
      <div class="profile-card" style="text-align: center;">
        <h4 style="margin-top: 0; font-weight: 700; color: #0f172a;">
          <i class="fa fa-camera" style="color: #04868f;"></i> Device Camera Capture
        </h4>
        <p style="color: #64748b; font-size: 13px;">
          Use your web or phone camera to snap a live profile photo.
        </p>

        <div class="camera-container" id="cameraBox">
          <div id="cameraPlaceholder" style="color: #94a3b8; padding: 20px;">
            <i class="fa fa-camera-retro" style="font-size: 48px; margin-bottom: 10px;"></i>
            <p style="margin: 0;">Click "Start Camera" to activate your device camera</p>
          </div>
          <video id="cameraStream" autoplay playsinline></video>
          <img id="photoPreview" alt="Captured photo preview">
          <canvas id="photoCanvas" style="display: none;"></canvas>
        </div>

        <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 16px;">
          <button type="button" class="btn btn-info" id="btnStartCamera">
            <i class="fa fa-video-camera"></i> Start Camera
          </button>
          <button type="button" class="btn btn-warning" id="btnCapturePhoto" style="display: none;">
            <i class="fa fa-dot-circle-o"></i> Capture Photo
          </button>
          <button type="button" class="btn btn-default" id="btnRetakePhoto" style="display: none;">
            <i class="fa fa-refresh"></i> Retake
          </button>
        </div>

        <div class="text-muted" style="margin-bottom: 16px; font-size: 12px;">— OR CHOOSE AN IMAGE FILE —</div>

        <input type="file" id="fileInput" accept="image/*" class="form-control" style="margin-bottom: 16px;">

        <!-- Form submitting the base64 or picture url to backend -->
        <form method="POST" action="/customer/update-profile-pic" id="profilePicForm">
          <input type="hidden" name="profile_pic" id="profilePicInput" value="">
          <button type="submit" class="btn btn-success btn-block" id="btnSavePic" style="font-weight: 700; padding: 10px; background: #04868f; border-color: #04868f;" disabled>
            <i class="fa fa-cloud-upload"></i> Save & Apply Profile Picture
          </button>
        </form>
      </div>
    </div>

    <!-- Right Column: Current Profile Details -->
    <div class="col-md-6">
      <div class="profile-card">
        <div style="text-align: center; margin-bottom: 20px;">
          <img src="<%= customer && customer.profile_pic ? customer.profile_pic : '/static/image/avatar-default.svg' %>"
               class="profile-avatar-large"
               onerror="this.src='/static/image/avatar-default.svg'"
               alt="Customer Profile Picture">
          <h4 style="margin: 12px 0 2px 0; font-weight: 700; color: #1e293b;">
            <%= customer ? (customer.first_name + ' ' + (customer.last_name || '')) : 'Valued Customer' %>
          </h4>
          <span style="font-size: 13px; color: #64748b;"><%= customer ? customer.email : '' %></span>
        </div>

        <form method="POST" action="/customer/update-profile">
          <div class="row">
            <div class="col-md-6 form-group">
              <label style="font-weight: 600; font-size: 13px;">First Name</label>
              <input type="text" name="first_name" class="form-control" value="<%= customer ? customer.first_name : '' %>" required>
            </div>
            <div class="col-md-6 form-group">
              <label style="font-weight: 600; font-size: 13px;">Last Name</label>
              <input type="text" name="last_name" class="form-control" value="<%= customer ? customer.last_name : '' %>">
            </div>
          </div>

          <div class="form-group">
            <label style="font-weight: 600; font-size: 13px;">Mobile Contact</label>
            <input type="text" name="mobile" class="form-control" value="<%= customer ? customer.mobile : '' %>" placeholder="+1 555-0199">
          </div>

          <div class="form-group">
            <label style="font-weight: 600; font-size: 13px;">Residential Address</label>
            <textarea name="address" class="form-control" rows="3"><%= customer ? customer.address : '' %></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="padding: 10px; font-weight: 600;">
            Update Profile Information
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  let videoStream = null;
  const video = document.getElementById('cameraStream');
  const canvas = document.getElementById('photoCanvas');
  const preview = document.getElementById('photoPreview');
  const placeholder = document.getElementById('cameraPlaceholder');
  const btnStart = document.getElementById('btnStartCamera');
  const btnCapture = document.getElementById('btnCapturePhoto');
  const btnRetake = document.getElementById('btnRetakePhoto');
  const btnSave = document.getElementById('btnSavePic');
  const inputPic = document.getElementById('profilePicInput');
  const fileInput = document.getElementById('fileInput');

  // Start Camera
  btnStart.addEventListener('click', async () => {
    try {
      videoStream = await navigator.mediaDevices.getUserMedia({
        video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' },
        audio: false
      });
      video.srcObject = videoStream;
      video.style.display = 'block';
      placeholder.style.display = 'none';
      preview.style.display = 'none';
      btnStart.style.display = 'none';
      btnCapture.style.display = 'inline-block';
      btnRetake.style.display = 'none';
    } catch (err) {
      alert('Camera access notice: Could not access device camera (' + err.message + '). You may upload an image file directly below.');
    }
  });

  // Capture Frame
  btnCapture.addEventListener('click', () => {
    if (!videoStream) return;
    canvas.width = video.videoWidth || 640;
    canvas.height = video.videoHeight || 480;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    const dataUrl = canvas.toDataURL('image/jpeg', 0.85);

    // Stop video track
    videoStream.getTracks().forEach(track => track.stop());
    videoStream = null;

    video.style.display = 'none';
    preview.src = dataUrl;
    preview.style.display = 'block';

    inputPic.value = dataUrl;
    btnCapture.style.display = 'none';
    btnRetake.style.display = 'inline-block';
    btnSave.disabled = false;
  });

  // Retake
  btnRetake.addEventListener('click', () => {
    btnStart.click();
    btnRetake.style.display = 'none';
    btnSave.disabled = true;
  });

  // File Upload fallback
  fileInput.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        const dataUrl = event.target.result;
        placeholder.style.display = 'none';
        video.style.display = 'none';
        preview.src = dataUrl;
        preview.style.display = 'block';
        inputPic.value = dataUrl;
        btnSave.disabled = false;
      };
      reader.readAsDataURL(file);
    }
  });
</script>

<%- include('../partials/customer_footer') %>
