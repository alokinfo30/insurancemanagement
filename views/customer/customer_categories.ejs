<%- include('../partials/customer_header') %>

<head>
  <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <style>
    .cat-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
    .cat-card {
      background: #ffffff;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      padding: 24px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .cat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
      border-color: #04868f;
    }
    .cat-icon-wrapper {
      width: 54px;
      height: 54px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin-bottom: 16px;
    }
    .icon-life { background: #e0e7ff; color: #4338ca; }
    .icon-health { background: #d1fae5; color: #047857; }
    .icon-motor { background: #fef3c7; color: #b45309; }
    .icon-travel { background: #e0f2fe; color: #0369a1; }
    .icon-general { background: #f3f4f6; color: #374151; }
  </style>
</head>

<div class="container" style="max-width: 1100px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 2px solid #e2e8f0;">
    <div>
      <h3 style="margin: 0; font-weight: 700; color: #1e293b;">
        <i class="fa fa-folder-open-o" style="color: #04868f;"></i> Policy Categories (Created by Admin)
      </h3>
      <p style="margin: 4px 0 0 0; color: #64748b; font-size: 14px;">
        Browse certified insurance categories provisioned and maintained by administrators.
      </p>
    </div>
    <a href="/customer/apply-policy" class="btn btn-primary" style="background: #04868f; border-color: #04868f; border-radius: 20px; font-weight: 600;">
      <i class="fa fa-th-large"></i> View All Policies
    </a>
  </div>

  <div class="cat-card-grid">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(function(cat) { %>
        <% 
          let iconClass = 'icon-general';
          let faIcon = 'fa-shield';
          const nameLower = (cat.category_name || '').toLowerCase();
          if (nameLower.includes('life')) { iconClass = 'icon-life'; faIcon = 'fa-heartbeat'; }
          else if (nameLower.includes('health') || nameLower.includes('medical')) { iconClass = 'icon-health'; faIcon = 'fa-medkit'; }
          else if (nameLower.includes('motor') || nameLower.includes('car') || nameLower.includes('auto')) { iconClass = 'icon-motor'; faIcon = 'fa-car'; }
          else if (nameLower.includes('travel') || nameLower.includes('trip')) { iconClass = 'icon-travel'; faIcon = 'fa-plane'; }

          // Count policies in this category
          const policyCount = policies ? policies.filter(p => p.category_id === cat.id || p.category_name === cat.category_name).length : 0;
        %>
        <div class="cat-card">
          <div>
            <div class="cat-icon-wrapper <%= iconClass %>">
              <i class="fa <%= faIcon %>"></i>
            </div>
            <h4 style="margin: 0 0 8px 0; font-weight: 700; color: #0f172a; font-size: 18px;">
              <%= cat.category_name %>
            </h4>
            <div style="font-size: 12px; color: #64748b; margin-bottom: 12px;">
              <i class="fa fa-calendar"></i> Added: <strong><%= cat.creation_date || 'Certified' %></strong>
            </div>
            <div style="display: inline-block; background: #f1f5f9; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 16px;">
              <i class="fa fa-file-text-o"></i> <%= policyCount %> Active <%= policyCount === 1 ? 'Plan' : 'Plans' %>
            </div>
          </div>

          <div>
            <a href="/customer/apply-policy" class="btn btn-block" style="background: #f8fafc; border: 1px solid #cbd5e1; color: #1e293b; font-weight: 600; font-size: 13px; border-radius: 6px; padding: 8px;">
              Browse Plans in <%= cat.category_name %> <i class="fa fa-arrow-right"></i>
            </a>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div style="grid-column: 1 / -1; text-align: center; padding: 50px; background: white; border-radius: 12px; border: 1px dashed #cbd5e1;">
        <i class="fa fa-folder-open-o" style="font-size: 48px; color: #94a3b8;"></i>
        <h4 style="margin-top: 16px; color: #334155;">No Categories Found</h4>
        <p style="color: #64748b;">Categories added by the administrator will automatically display here.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/customer_footer') %>
