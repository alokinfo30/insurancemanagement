<%- include('../partials/customer_header') %>

<head>
  <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
  <style media="screen">
    a:link {
      text-decoration: none;
    }
    h6 {
      text-align: center;
    }
  </style>
</head>

<div class="container">
  <div class="panel panel-primary">
    <div class="panel-heading">
      <h6 class="panel-title">Asked Question History</h6>
    </div>
    <table class="table table-hover" id="dev-table">
      <thead>
        <tr>
          <th>Serial No.</th>
          <th>Question</th>
          <th>Admin Comment</th>
          <th>Asked Date</th>
        </tr>
      </thead>
      <tbody>
        <% if (questions && questions.length > 0) { %>
          <% questions.forEach(function(t, index) { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= t.description %></td>
              <td>
                <span class="<%= t.admin_comment === 'Nothing' ? 'text-muted' : 'text-success font-weight-bold' %>">
                  <%= t.admin_comment %>
                </span>
              </td>
              <td><%= t.asked_date %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="4" class="text-center">No questions asked yet. <a href="/customer/ask-question">Ask a question here</a>.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/customer_footer') %>
