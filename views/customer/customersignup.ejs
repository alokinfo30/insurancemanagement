<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <title>Customer Signup - Insurance Management System</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
  <style>
    form {
      margin: 50px auto;
      max-width: 800px;
      padding: 30px;
      background: #fdfdfd;
      border: 1px solid #ddd;
      border-radius: 8px;
    }
  </style>
</head>
<body>
  <%- include('../partials/navbar') %>

  <br><br><br>
  <h3 style="text-align: center; color: red;">CUSTOMER SIGNUP</h3>
  
  <form method="POST" action="/customer/customersignup" autocomplete="off">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="form-row">
      <div class="form-group col-md-6">
        <label for="username">Username</label>
        <input type="text" name="username" class="form-control" placeholder="Username" required>
      </div>
      <div class="form-group col-md-6">
        <label for="password">Password</label>
        <input type="password" name="password" class="form-control" placeholder="Password" required>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group col-md-6">
        <label for="first_name">First Name</label>
        <input type="text" name="first_name" class="form-control" placeholder="First Name" required>
      </div>
      <div class="form-group col-md-6">
        <label for="last_name">Last Name</label>
        <input type="text" name="last_name" class="form-control" placeholder="Last Name" required>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group col-md-6">
        <label for="mobile">Mobile</label>
        <input type="text" name="mobile" class="form-control" placeholder="Mobile" required>
      </div>
      <div class="form-group col-md-6">
        <label for="address">Address</label>
        <input type="text" name="address" class="form-control" placeholder="Address" required>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group col-md-12">
        <label for="profile_pic">Profile Picture URL (or leave default)</label>
        <input type="text" name="profile_pic" class="form-control" placeholder="/static/profile_pic/Customer/lazy.PNG" value="/static/profile_pic/Customer/lazy.PNG">
      </div>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Sign Up</button>
    <div class="text-center mt-3" style="margin-top: 15px;">
      <small>Already have an account? <a href="/customer/customerlogin">Login here</a></small>
    </div>
  </form>

  <br><br>
  <%- include('../partials/footer') %>
</body>
</html>
