{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access for Admin or Customer",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "role": { "type": "string", "enum": ["ADMIN", "CUSTOMER"] },
        "first_name": { "type": "string", "maxLength": 64 },
        "last_name": { "type": "string", "maxLength": 64 },
        "mobile": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 256 },
        "profile_pic": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Document marking a verified user as having Administrator privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "addedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "Category": {
      "title": "Category",
      "description": "Insurance plan category created by admin",
      "type": "object",
      "properties": {
        "category_name": { "type": "string", "maxLength": 100 },
        "creation_date": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["category_name"]
    },
    "Policy": {
      "title": "Policy",
      "description": "Insurance plan specification",
      "type": "object",
      "properties": {
        "policy_name": { "type": "string", "maxLength": 120 },
        "category_id": { "type": "string", "maxLength": 64 },
        "category_name": { "type": "string", "maxLength": 100 },
        "sum_assurance": { "type": "number" },
        "premium": { "type": "number" },
        "tenure": { "type": "number" },
        "creation_date": { "type": "string", "maxLength": 30 },
        "description": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" }
      },
      "required": ["policy_name", "category_id", "sum_assurance", "premium", "tenure"]
    },
    "PolicyRecord": {
      "title": "PolicyRecord",
      "description": "Applied policy application by a customer",
      "type": "object",
      "properties": {
        "customer_id": { "type": "string", "maxLength": 128 },
        "customer_name": { "type": "string", "maxLength": 128 },
        "customer_email": { "type": "string", "format": "email", "maxLength": 128 },
        "policy_id": { "type": "string", "maxLength": 64 },
        "policy_name": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Disapproved"] },
        "creation_date": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["customer_id", "policy_id", "status"]
    },
    "Claim": {
      "title": "Claim",
      "description": "Customer insurance claim submission and status tracking",
      "type": "object",
      "properties": {
        "customer_id": { "type": "string", "maxLength": 128 },
        "customer_name": { "type": "string", "maxLength": 128 },
        "customer_email": { "type": "string", "format": "email", "maxLength": 128 },
        "policy_id": { "type": "string", "maxLength": 64 },
        "policy_name": { "type": "string", "maxLength": 120 },
        "claim_amount": { "type": "number" },
        "incident_date": { "type": "string", "maxLength": 30 },
        "reason": { "type": "string", "maxLength": 256 },
        "supporting_details": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["Pending", "Under Review", "Approved", "Rejected"] },
        "admin_remarks": { "type": "string", "maxLength": 2000 },
        "settlement_amount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["customer_id", "policy_id", "claim_amount", "status"]
    },
    "Question": {
      "title": "Question",
      "description": "Customer support question and admin response",
      "type": "object",
      "properties": {
        "customer_id": { "type": "string", "maxLength": 128 },
        "customer_name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 2000 },
        "admin_comment": { "type": "string", "maxLength": 2000 },
        "asked_date": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["customer_id", "description"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered customer and admin accounts"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Verified system administrators directory"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Insurance policy categories created by admin"
    },
    "/policies/{policyId}": {
      "schema": { "$ref": "#/entities/Policy" },
      "description": "Insurance policy plans"
    },
    "/policy_records/{recordId}": {
      "schema": { "$ref": "#/entities/PolicyRecord" },
      "description": "Customer policy applications"
    },
    "/claims/{claimId}": {
      "schema": { "$ref": "#/entities/Claim" },
      "description": "Customer claims submitted and tracked through Firestore"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Customer support questions and admin responses"
    }
  }
}
